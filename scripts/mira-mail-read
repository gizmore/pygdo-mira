#!/usr/bin/env bash
set -euo pipefail

QUEUE="${MIRA_MAIL_QUEUE:-/home/mira/inbound/queue}"

if [[ $# -gt 1 ]]; then
    printf 'usage: %s [message.eml]\n' "$0" >&2
    exit 2
fi

if [[ $# -eq 1 ]]; then
    message=$1
else
    message=$(find "$QUEUE" -maxdepth 1 -type f -name '*.eml' -printf '%T@ %p\n' |
        sort -n | tail -1 | cut -d' ' -f2-)
fi

if [[ -z "${message:-}" || ! -f "$message" ]]; then
    printf 'No queued mail found in %s\n' "$QUEUE"
    exit 1
fi

case "$message" in
    "$QUEUE"/*.eml) ;;
    *) printf 'Refusing to read a file outside %s\n' "$QUEUE" >&2; exit 2 ;;
esac

printf '%s\n' "--- $message ---"
awk '
    BEGIN { in_headers = 1 }
    in_headers && /^$/ { in_headers = 0; print ""; next }
    in_headers { print; next }
    { print }
' "$message"
